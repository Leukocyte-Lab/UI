{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2021", "ES2021.Intl", "ESNext", "DOM", "DOM.Iterable"],
    "types": ["node", "jsdom"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "ignoreDeprecations": "5.0",
  "exclude": ["node_modules", "src/**/*.stories.ts"]
}
