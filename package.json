{
  "name": "@leukocyte-lab/ui",
  "version": "0.8.0-beta.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Leukocyte-Lab/UI.git"
  },
  "dependencies": {
    "@iconify/vue": "^4.1.2",
    "vue": "^3.4.37"
  },
  "exports": {
    "./shared": {
      "import": "./dist/ui.shared.es.js",
      "require": "./dist/ui.shared.cjs.js",
      "types": "./dist/src/shared/index.d.ts"
    },
    "./component": {
      "import": "./dist/ui.component.es.js",
      "require": "./dist/ui.component.cjs.js",
      "types": "./dist/src/components/index.d.ts"
    },
    "./flow": {
      "import": "./dist/ui.flow.es.js",
      "require": "./dist/ui.flow.cjs.js",
      "types": "./dist/src/components/flow/index.d.ts"
    },
    "./middleware": {
      "import": "./dist/ui.middleware.es.js",
      "require": "./dist/ui.middleware.cjs.js",
      "types": "./dist/src/middleware/index.d.ts"
    },
    "./styles/": "./dist/styles/",
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist/*"
  ],
  "devDependencies": {
    "@chromatic-com/storybook": "^2.0.2",
    "@eslint/compat": "^1.1.1",
    "@eslint/js": "^9.9.0",
    "@etchteam/storybook-addon-css-variables-theme": "^3.0.0",
    "@iconify-json/fa6-brands": "^1.1.22",
    "@iconify-json/fa6-regular": "^1.1.22",
    "@iconify-json/fa6-solid": "^1.1.24",
    "@leukocyte-lab/theme": "^1.1.4",
    "@rushstack/eslint-patch": "^1.10.4",
    "@storybook/addon-a11y": "^8.3.3",
    "@storybook/addon-actions": "^8.3.3",
    "@storybook/addon-essentials": "^8.3.3",
    "@storybook/addon-interactions": "^8.3.3",
    "@storybook/addon-links": "^8.3.3",
    "@storybook/blocks": "^8.3.3",
    "@storybook/preview-api": "^8.3.3",
    "@storybook/test": "^8.3.3",
    "@storybook/vue3": "^8.3.3",
    "@storybook/vue3-vite": "^8.3.3",
    "@tsconfig/node20": "^20.1.4",
    "@types/eslint__js": "^8.42.3",
    "@types/jsdom": "^21.1.7",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.2.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^5.1.2",
    "@vue/compiler-sfc": "^3.4.37",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.5.1",
    "@vueuse/components": "^10.11.1",
    "@vueuse/core": "^10.11.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "dice-coefficient": "^2.1.1",
    "eslint": "^9.9.0",
    "eslint-plugin-promise": "^7.1.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-storybook": "0.9.0--canary.156.ed236ca.0",
    "eslint-plugin-vue": "^9.27.0",
    "gradient2svg": "^0.0.4",
    "jsdom": "^24.1.1",
    "jsonpath-plus": "^9.0.0",
    "lodash-es": "^4.17.21",
    "npm-run-all": "^4.1.5",
    "pixi.js": "^7.4.2",
    "prettier": "^3.3.3",
    "sass": "^1.77.8",
    "storybook": "^8.3.3",
    "stylelint": "^16.8.1",
    "stylelint-config-recommended-vue": "^1.5.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "stylelint-scss": "^6.5.0",
    "tsc-alias": "^1.8.10",
    "typescript": "~5.5.4",
    "typescript-eslint": "^8.1.0",
    "uuid": "^10.0.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.5",
    "vue-component-type-helpers": "^2.1.6",
    "vue-tsc": "^2.0.29",
    "vue3-pixi": "^0.9.3",
    "xregexp": "^5.1.1"
  },
  "overrides": {
    "eslint-plugin-storybook": {
      "@typescript-eslint/utils": "$@typescript-eslint/utils"
    }
  },
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open",
    "postinstall": "pnpm run setup-git-hooks",
    "setup-git-hooks": "git config core.hooksPath .githooks",
    "build": "vite build",
    "build:check": "run-p lint type-check",
    "build:prod": "run-p build",
    "build:type": "vue-tsc --noEmit false --declaration --emitDeclarationOnly -p tsconfig.app.json --composite false --outDir dist && tsc-alias -p tsconfig.app.json --outDir dist",
    "build:assets": "cp -r ./src/assets/styles ./dist",
    "build:storybook": "VITE_STORYBOOK=true storybook build",
    "preview": "vite preview",
    "test:unit": "vitest --typecheck",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "lint": "run-p lint:eslint lint:stylelint",
    "lint:eslint": "eslint . --fix",
    "lint:stylelint": "stylelint 'src/**/*.{css,scss,sass,vue}' --fix"
  }
}