{
  "name": "ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:check": "run-p lint type-check",
    "build:prod": "run-p build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "lint": "run-p lint:eslint lint:stylelint",
    "lint:eslint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "lint:stylelint": "stylelint 'src/**/*.{css,scss,sass,vue}' --fix",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build && cp -r theme/ storybook-static/theme"
  },
  "dependencies": {
    "@iconify-json/fa6-brands": "^1.1.11",
    "@iconify-json/fa6-regular": "^1.1.11",
    "@iconify-json/fa6-solid": "^1.1.13",
    "@iconify/vue": "^4.1.1",
    "@tsconfig/node18": "^2.0.1",
    "@vitejs/plugin-vue": "^4.2.3",
    "@vue/tsconfig": "^0.4.0",
    "@vueuse/core": "^10.1.2",
    "gradient2svg": "^0.0.4",
    "lodash-es": "^4.17.21",
    "npm-run-all": "^4.1.5",
    "sass": "^1.62.1",
    "typescript": "~5.0.4",
    "uuid": "^9.0.0",
    "vite": "^4.3.7",
    "vite-plugin-dts": "^2.3.0",
    "vue": "^3.3.2"
  },
  "exports": {
    "./shared": {
      "import": "./dist/ui.shared.es.js",
      "require": "./dist/ui.shared.cjs.js",
      "type": "./dist/shared.d.ts"
    },
    "./component": {
      "import": "./dist/ui.component.es.js",
      "require": "./dist/ui.component.cjs.js",
      "type": "./dist/component.d.ts"
    }
  },
  "files": [
    "dist/*"
  ],
  "devDependencies": {
    "@etchteam/storybook-addon-css-variables-theme": "^1.5.1",
    "@rushstack/eslint-patch": "^1.2.0",
    "@storybook/addon-essentials": "^7.0.12",
    "@storybook/addon-interactions": "^7.0.12",
    "@storybook/addon-links": "^7.0.12",
    "@storybook/blocks": "^7.0.12",
    "@storybook/testing-library": "^0.0.14-next.2",
    "@storybook/vue3": "^7.0.12",
    "@storybook/vue3-vite": "^7.0.12",
    "@types/jsdom": "^21.1.1",
    "@types/lodash-es": "^4.17.7",
    "@types/node": "^18.16.12",
    "@types/uuid": "^9.0.1",
    "@vue/eslint-config-prettier": "^7.1.0",
    "@vue/eslint-config-typescript": "^11.0.3",
    "@vue/test-utils": "^2.3.2",
    "eslint": "^8.40.0",
    "eslint-plugin-storybook": "^0.6.12",
    "eslint-plugin-vue": "^9.13.0",
    "jsdom": "^22.0.0",
    "prettier": "^2.8.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "storybook": "^7.0.12",
    "stylelint": "^15.6.2",
    "stylelint-config-recommended-vue": "^1.4.0",
    "stylelint-config-standard-scss": "^9.0.0",
    "stylelint-scss": "^5.0.0",
    "vitest": "^0.31.0",
    "vue-tsc": "^1.6.5"
  }
}
