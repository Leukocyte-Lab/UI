{
  "name": "@leukocyte-lab/ui",
  "version": "0.7.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Leukocyte-Lab/UI.git"
  },
  "dependencies": {
    "@iconify/vue": "^4.1.1",
    "vue": "^3.4.19"
  },
  "exports": {
    "./shared": {
      "import": "./dist/ui.shared.es.js",
      "require": "./dist/ui.shared.cjs.js",
      "types": "./dist/src/shared/index.d.ts"
    },
    "./component": {
      "import": "./dist/ui.component.es.js",
      "require": "./dist/ui.component.cjs.js",
      "types": "./dist/src/components/index.d.ts"
    },
    "./flow": {
      "import": "./dist/ui.flow.es.js",
      "require": "./dist/ui.flow.cjs.js",
      "types": "./dist/src/components/flow/index.d.ts"
    },
    "./middleware": {
      "import": "./dist/ui.middleware.es.js",
      "require": "./dist/ui.middleware.cjs.js",
      "types": "./dist/src/middleware/index.d.ts"
    },
    "./styles/": "./dist/styles/",
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist/*"
  ],
  "devDependencies": {
    "@etchteam/storybook-addon-css-variables-theme": "^2.0.6",
    "@iconify-json/fa6-brands": "^1.1.18",
    "@iconify-json/fa6-regular": "^1.1.18",
    "@iconify-json/fa6-solid": "^1.1.20",
    "@leukocyte-lab/theme": "^1.1.1",
    "@rushstack/eslint-patch": "^1.7.2",
    "@storybook/addon-essentials": "^7.6.17",
    "@storybook/addon-interactions": "^7.6.17",
    "@storybook/addon-links": "^7.6.17",
    "@storybook/blocks": "^7.6.17",
    "@storybook/testing-library": "0.2.2",
    "@storybook/vue3": "^7.6.17",
    "@storybook/vue3-vite": "^7.6.17",
    "@tsconfig/node18": "^18.2.2",
    "@types/jsdom": "^21.1.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.11.19",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/compiler-sfc": "^3.4.19",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "2.4.4",
    "@vue/tsconfig": "^0.5.1",
    "@vueuse/components": "^10.8.0",
    "@vueuse/core": "^10.8.0",
    "date-fns": "^2.30.0",
    "date-fns-tz": "^2.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-storybook": "^0.6.15",
    "eslint-plugin-vue": "^9.21.1",
    "gradient2svg": "^0.0.4",
    "jsdom": "^24.0.0",
    "jsonpath-plus": "^8.0.0",
    "lodash-es": "^4.17.21",
    "npm-run-all": "^4.1.5",
    "pixi.js": "^7.4.0",
    "prettier": "^3.2.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sass": "^1.71.1",
    "storybook": "^7.6.17",
    "stylelint": "^16.2.1",
    "stylelint-config-recommended-vue": "^1.5.0",
    "stylelint-config-standard-scss": "^13.0.0",
    "stylelint-scss": "^6.1.0",
    "tsc-alias": "^1.8.8",
    "typescript": "~5.3.3",
    "uuid": "^9.0.1",
    "vite": "^5.1.4",
    "vitest": "^1.3.1",
    "vue-tsc": "^1.8.27",
    "vue3-pixi": "^0.9.1",
    "xregexp": "^5.1.1"
  },
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open",
    "postinstall": "pnpm run setup-git-hooks",
    "setup-git-hooks": "git config core.hooksPath .githooks",
    "build": "vite build",
    "build:check": "run-p lint type-check",
    "build:prod": "run-p build",
    "build:type": "vue-tsc --noEmit false --declaration --emitDeclarationOnly -p tsconfig.app.json --composite false --outDir dist && tsc-alias -p tsconfig.app.json --outDir dist",
    "build:assets": "cp -r ./src/assets/styles ./dist",
    "build:storybook": "VITE_STORYBOOK=true storybook build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "lint": "run-p lint:eslint lint:stylelint",
    "lint:eslint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "lint:stylelint": "stylelint 'src/**/*.{css,scss,sass,vue}' --fix"
  }
}