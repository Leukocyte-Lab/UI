{
  "name": "@leukocyte-lab/ui",
  "version": "0.1.3",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Leukocyte-Lab/UI.git"
  },
  "dependencies": {
    "@iconify-json/fa6-brands": "^1.1.13",
    "@iconify-json/fa6-regular": "^1.1.13",
    "@iconify-json/fa6-solid": "^1.1.15",
    "@iconify/vue": "^4.1.1",
    "vue": "^3.3.4"
  },
  "exports": {
    "./shared": {
      "import": "./dist/ui.shared.es.js",
      "require": "./dist/ui.shared.cjs.js",
      "types": "./dist/shared/index.d.ts"
    },
    "./component": {
      "import": "./dist/ui.component.es.js",
      "require": "./dist/ui.component.cjs.js",
      "types": "./dist/components/index.d.ts"
    },
    "./styles/": "./dist/styles/",
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist/*"
  ],
  "devDependencies": {
    "@etchteam/storybook-addon-css-variables-theme": "^1.5.1",
    "@rushstack/eslint-patch": "^1.3.3",
    "@storybook/addon-essentials": "7.2.2",
    "@storybook/addon-interactions": "7.2.2",
    "@storybook/addon-links": "7.2.2",
    "@storybook/blocks": "7.2.2",
    "@storybook/testing-library": "0.2.0",
    "@storybook/vue3": "7.2.2",
    "@storybook/vue3-vite": "7.2.2",
    "@tsconfig/node18": "^18.2.0",
    "@types/jsdom": "^21.1.1",
    "@types/lodash-es": "^4.17.8",
    "@types/node": "^20.4.9",
    "@types/uuid": "^9.0.2",
    "@vitejs/plugin-vue": "^4.2.3",
    "@vue/compiler-sfc": "^3.3.4",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^11.0.3",
    "@vue/test-utils": "^2.4.1",
    "@vue/tsconfig": "^0.4.0",
    "@vueuse/components": "^10.3.0",
    "@vueuse/core": "^10.3.0",
    "date-fns-tz": "^2.0.0",
    "eslint": "^8.46.0",
    "eslint-plugin-storybook": "^0.6.13",
    "eslint-plugin-vue": "^9.17.0",
    "gradient2svg": "^0.0.4",
    "jsdom": "^22.1.0",
    "jsonpath-plus": "^7.2.0",
    "lodash-es": "^4.17.21",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sass": "^1.65.1",
    "storybook": "7.2.2",
    "stylelint": "^15.10.2",
    "stylelint-config-recommended-vue": "^1.5.0",
    "stylelint-config-standard-scss": "^10.0.0",
    "stylelint-scss": "^5.1.0",
    "tsc-alias": "^1.8.7",
    "typescript": "~5.1.6",
    "uuid": "^9.0.0",
    "vite": "^4.4.9",
    "vitest": "^0.34.1",
    "vue-tsc": "^1.8.8",
    "xregexp": "^5.1.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:check": "run-p lint type-check",
    "build:prod": "run-p build",
    "build:type": "vue-tsc --declaration --emitDeclarationOnly -p tsconfig.app.json --composite false --outDir dist && tsc-alias -p tsconfig.app.json --outDir dist",
    "build:assets": "cp -r ./src/assets/styles ./dist",
    "build:storybook": "VITE_STORYBOOK=true storybook build && cp -r theme/ storybook-static/theme",
    "preview": "vite preview",
    "test:unit": "vitest",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "lint": "run-p lint:eslint lint:stylelint",
    "lint:eslint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "lint:stylelint": "stylelint 'src/**/*.{css,scss,sass,vue}' --fix",
    "storybook": "storybook dev -p 6006"
  }
}