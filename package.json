{
  "name": "@leukocyte-lab/ui",
  "version": "0.11.2",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Leukocyte-Lab/UI.git"
  },
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open",
    "postinstall": "pnpm run setup-git-hooks",
    "setup-git-hooks": "git config core.hooksPath .githooks",
    "build": "vite build",
    "build:check": "run-p lint type-check",
    "build:prod": "run-p build",
    "build:type": "vue-tsc --noEmit false --declaration --emitDeclarationOnly -p tsconfig.app.json --composite false --outDir dist && tsc-alias -p tsconfig.app.json --outDir dist",
    "build:assets": "cp -r ./src/assets/styles ./dist",
    "build:storybook": "VITE_STORYBOOK=true storybook build",
    "preview": "vite preview",
    "test:unit": "vitest --typecheck",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "lint": "run-p lint:eslint lint:stylelint",
    "lint:eslint": "eslint . --fix",
    "lint:stylelint": "stylelint 'src/**/*.{css,scss,sass,vue}' --fix"
  },
  "dependencies": {
    "@iconify/vue": "^4.3.0",
    "vue": "^3.5.27"
  },
  "exports": {
    "./shared": {
      "import": "./dist/ui.shared.es.js",
      "require": "./dist/ui.shared.cjs.js",
      "types": "./dist/src/shared/index.d.ts"
    },
    "./component": {
      "import": "./dist/ui.component.es.js",
      "require": "./dist/ui.component.cjs.js",
      "types": "./dist/src/components/index.d.ts"
    },
    "./flow": {
      "import": "./dist/ui.flow.es.js",
      "require": "./dist/ui.flow.cjs.js",
      "types": "./dist/src/components/flow/index.d.ts"
    },
    "./middleware": {
      "import": "./dist/ui.middleware.es.js",
      "require": "./dist/ui.middleware.cjs.js",
      "types": "./dist/src/middleware/index.d.ts"
    },
    "./styles/": "./dist/styles/",
    "./style.css": "./dist/ui.css"
  },
  "files": [
    "dist/*"
  ],
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.0",
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.2",
    "@etchteam/storybook-addon-css-variables-theme": "^3.0.0",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-regular": "^1.2.4",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@leukocyte-lab/theme": "^1.2.3",
    "@rushstack/eslint-patch": "^1.15.0",
    "@storybook/addon-a11y": "^10.2.4",
    "@storybook/addon-docs": "^10.2.4",
    "@storybook/addon-links": "^10.2.4",
    "@storybook/addon-themes": "^10.2.4",
    "@storybook/addon-vitest": "^10.2.4",
    "@storybook/vue3-vite": "^10.2.4",
    "@tsconfig/node20": "^20.1.8",
    "@types/eslint__js": "^8.42.3",
    "@types/jsdom": "^21.1.7",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.19.31",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/typescript-estree": "^8.54.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/compiler-sfc": "^3.5.27",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "@vueuse/components": "^10.11.1",
    "@vueuse/core": "^10.11.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "dice-coefficient": "^2.1.1",
    "eslint": "^9.39.2",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-storybook": "^10.2.4",
    "eslint-plugin-vue": "^9.33.0",
    "gradient2svg": "^0.0.4",
    "jsdom": "^24.1.3",
    "jsonpath-plus": "^10.3.0",
    "lodash-es": "^4.17.23",
    "npm-run-all": "^4.1.5",
    "pixi.js": "^7.4.3",
    "prettier": "^3.8.1",
    "sass": "^1.97.3",
    "storybook": "^10.2.4",
    "storybook-addon-vue-slots": "0.9.30-next.2",
    "stylelint": "^16.26.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^13.1.0",
    "stylelint-scss": "^6.14.0",
    "tsc-alias": "^1.8.16",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.54.0",
    "uuid": "^10.0.0",
    "vite": "^7.3.1",
    "vitest": "^3.2.4",
    "vue-component-type-helpers": "^2.2.12",
    "vue-tsc": "^3.2.4",
    "vue3-pixi": "^0.9.8",
    "xregexp": "^5.1.2",
    "playwright": "^1.58.1",
    "@vitest/browser": "3.2.4",
    "@vitest/coverage-v8": "3.2.4"
  },
  "overrides": {
    "eslint-plugin-storybook": {
      "@typescript-eslint/utils": "$@typescript-eslint/utils"
    }
  },
  "pnpm": {
    "overrides": {
      "nanoid@>=4.0.0 <5.0.9": ">=5.0.9",
      "esbuild@<=0.24.2": ">=0.25.0"
    }
  }
}
