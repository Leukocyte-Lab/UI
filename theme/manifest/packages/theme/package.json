{
  "name": "@leukocyte-lab/theme",
  "description": "Leukocyte-Lab Theme in Design Token format",
  "version": "1.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Leukocyte-Lab/Design-Token.git"
  },
  "exports": {
    "./*": "./*",
    "./metallic/": "./Metallic-Bright/",
    "./metallic/variables.css": "./Metallic-Bright/css/variables.css",
    "./metallic/variables.scss": "./Metallic-Bright/css/variables.scss",
    "./metallic/bright/": "./Metallic-Bright/",
    "./metallic/bright/variables.css": "./Metallic-Bright/css/variables.css",
    "./metallic/bright/variables.scss": "./Metallic-Bright/css/variables.scss",
    "./metallic/dark/": "./Metallic-Dark/",
    "./metallic/dark/variables.css": "./Metallic-Dark/css/variables.css",
    "./metallic/dark/variables.scss": "./Metallic-Dark/css/variables.scss",
    "./kpt/": "./KPT/",
    "./kpt/variables.css": "./KPT/css/variables.css",
    "./kpt/variables.scss": "./KPT/css/variables.scss"
  },
  "files": [
    "Metallic-Bright/*",
    "Metallic-Dark/*",
    "KPT/*"
  ]
}